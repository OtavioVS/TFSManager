# Azure DevOps Services:
AZDO_ORG_URL=https://dev.azure.com/ORG

# Azure DevOps Server/TFS on-premises:
# AZDO_COLLECTION_URL=https://servidor/tfs/Collection

AZDO_PROJECT=PROJETO
AZDO_PAT=
AZDO_API_VERSION=7.1

AZDO_ALLOWED_STATES=New,Active,Resolved,Closed

# Mapa coluna do taskboard -> estado real. Ex.: "Code Review:Resolved" faz
# "--column 'Code Review'" setar System.State=Resolved.
AZDO_TASKBOARD_COLUMN_MAP=New:New,Active:Active,Code Review:Resolved,Closed:Closed

AZDO_IDENTITIES_PATH=config/identities.json
AZDO_REQUIRE_ASSIGNED_TO_MATCH=true

MAX_HOURS_PER_COMMAND=8
MAX_HOURS_PER_DAY=8
REQUIRE_CONFIRMATION=false
# Lancar horas em dia que ainda nao aconteceu.
# true  = so avisa (padrao)
# false = bloqueia o lancamento
ALLOW_FUTURE_HOURS=true
AUDIT_LOG_PATH=logs/audit.jsonl

# Campo opcional do Azure DevOps usado pelo Timebox como numero da demanda.
# No PLUGIN-TIMEBOX atual, o frontend le Custom.bef8a8bc-fe87-48b5-b28e-50656841f0eb.
AZDO_DEMAND_NUMBER_FIELD=Custom.bef8a8bc-fe87-48b5-b28e-50656841f0eb

# Integracao opcional com PLUGIN-TIMEBOX.
# TIMEBOX_API_URL deve apontar para a base /api do backend, ex.: http://localhost:5256/api.
TIMEBOX_ENABLED=false
TIMEBOX_API_URL=http://localhost:5256/api
TIMEBOX_USER_ID=

# Opcao A: informe um JWT ja emitido pelo Timebox.
TIMEBOX_AUTH_TOKEN=

# Opcao B: deixe TIMEBOX_AUTH_TOKEN vazio e informe estes dados para o CLI gerar o JWT em PUT /v1/user.
TIMEBOX_ORGANIZATION_ID=
TIMEBOX_USER_NAME=
TIMEBOX_USER_DISPLAY_NAME=
TIMEBOX_APP_TOKEN=